{
  "name": "debug-to-jupyter-rust",
  "displayName": "Debug to Jupyter (Rust Wasm)",
  "version": "1.0.0",
  "publisher": "sangnpq",
  "repository": "https://github.com/sangnpq/memory2jupyter",
  "description": "Export a live Python variable from a debug session into a Jupyter Notebook, configured to use the same virtual environment.",
  "engines": {
    "vscode": "^1.75.0",
    "node": "20.x"
  },
  "activationEvents": [
    "onDebug"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "ms-python.python"
  ],
  "contributes": {
    "commands": [
      {
        "command": "d2j.sendToJupyter",
        "title": "Send to Jupyter Notebook",
        "category": "Debug"
      }
    ],
    "menus": {
      "debug/variables/context": [
        {
          "command": "d2j.sendToJupyter",
          "when": "debugState == stopped",
          "group": "1_modification"
        }
      ]
    }
  },
  "scripts": {
    "build:wasm": "cd cargo && ~/.cargo/bin/wasm-pack build --target nodejs --out-dir ../pkg --release",
    "build:wasm:dev": "cd cargo && ~/.cargo/bin/wasm-pack build --target nodejs --out-dir ../pkg --dev",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:wasm && npm run build:ts",
    "watch:ts": "tsc -p tsconfig.json --watch",
    "package": "npm run build && vsce package",
    "pretest": "npm run build:ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.7"
  }
}
